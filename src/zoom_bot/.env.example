# Zoom AI Bot credentials
# Copy to /opt/zoom-bot/.env inside the OrbStack VM and fill in values.
#
# Zoom Meeting SDK (https://marketplace.zoom.us → Build App → General App)
ZOOM_APP_CLIENT_ID=
ZOOM_APP_CLIENT_SECRET=

# Deepgram STT (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Groq LLM (https://console.groq.com)
GROQ_API_KEY=

# ElevenLabs TTS (https://elevenlabs.io)
ELEVENLABS_API_KEY=
